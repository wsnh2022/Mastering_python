from typing import List, Dict, Tuple


def error_counts(logs: List[str]) -> Dict[str, int]:
    """Return {service_name: number_of_ERROR_lines}."""
    counts: Dict[str, int] = {}

    for line in logs:
        if not isinstance(line, str):
            continue

        parts = [p.strip() for p in line.split("|")]

        # Skip malformed lines
        if len(parts) < 4:
            continue

        _, service, level, _ = parts[:4]

        if level == "ERROR":
            counts[service] = counts.get(service, 0) + 1

    return counts


def top_errors(logs: List[str], n: int) -> List[Tuple[str, int]]:
    """
    Return the n services with the most ERROR lines,
    highest count first. Break ties alphabetically.
    """
    if n <= 0:
        return []

    counts = error_counts(logs)

    # Sort by count descending, then service name ascending
    sorted_items = sorted(counts.items(), key=lambda x: (-x[1], x[0]))

    return sorted_items[:n]


# ---------------- Example from question ----------------

logs = [
    "2026-08-07 10:00:01 | payment-service | ERROR | Timeout",
    "2026-08-07 10:00:02 | auth-service | INFO | Login OK",
    "2026-08-07 10:00:05 | payment-service | ERROR | Card declined",
    "bad line",
    "2026-08-07 10:00:09 | auth-service | ERROR | Token expired",
]

print(error_counts(logs))
print(top_errors(logs, 1))


